{% extends '@admin/default_frame.twig' %}
{% set menus = ['order', 'remisePayment4AcNavManagement'] %}

{% block title %}{{ 'remise_payment4.ac.admin_management_index.label.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'remise_payment4.ac.admin_management_index.label.sub_title'|trans }}{% endblock %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/tempusdominus-bootstrap-4.min.css', 'admin') }}">
    <style type="text/css">
        .datepicker-days th.dow:first-child,
        .datepicker-days td:first-child {
            color: #f00;
        }

        .datepicker-days th.dow:last-child,
        .datepicker-days td:last-child {
            color: #00f;
        }
    </style>
{% endblock stylesheet %}

{% block javascript %}
<script>
    $(function() {
        if ($('[type="date"]').prop('type') != 'date') {
            // input type属性でdateが利用できるかどうか(カレンダー表示できないブラウザ対応)
            $.when(
                $.getScript("{{ asset('assets/js/vendor/moment.min.js', 'admin') }}"),
                $.getScript("{{ asset('assets/js/vendor/moment-with-locales.min.js', 'admin') }}"),
                $.getScript("{{ asset('assets/js/vendor/tempusdominus-bootstrap-4.min.js', 'admin') }}")
            ).done(function() {
                $('input[id$=_date_start]').datetimepicker({
                    locale: '{{ eccube_config.locale }}',
                    format: 'YYYY/MM/DD',
                    useCurrent: false,
                    buttons: {
                        showToday: true,
                        showClose: true
                    }
                });

                $('input[id$=_date_end]').datetimepicker({
                    locale: '{{ eccube_config.locale }}',
                    format: 'YYYY-MM-DD',
                    useCurrent: false,
                    buttons: {
                        showToday: true,
                        showClose: true
                    }
                });
            });
        }
    });
</script>
{% endblock javascript %}

{% block main %}
    <!--検索条件設定テーブルここから-->
    <div class="c-outsideBlock">
        <form name="search_form" id="search_form" method="POST" action="{{ url('remise_payment4_ac_management_index') }}">
            <div class="c-outsideBlock__contents">
                <div class="row">
                    <div class="col-12">
                        {{ form_widget(searchForm._token) }}
                        <div>
                            <label class="col-form-label" data-tooltip="true" data-placement="top" title="{{ 'tooltip.order.multi_search_label'|trans }}">{{ 'remise_payment4.ac.admin_management_index.label.search.multi'|trans }}<i class="fa fa-question-circle fa-lg ml-1"></i></label>
                            {{ form_widget(searchForm.multi) }}
                            {{ form_errors(searchForm.multi) }}
                        </div>
                        <div class="d-inline-block mb-3 collapsed" data-bs-toggle="collapse" href="#searchDetail" aria-expanded="false" aria-controls="searchDetail">
                            <a>
                                <i class="fa font-weight-bold mr-1 fa-plus-square-o">
                                    <span class="font-weight-bold">{{ 'admin.common.search_detail'|trans }}</span>
                                </i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="c-subContents ec-collapse collapse{{ has_errors ? ' show' }}" id="searchDetail">
                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.status'|trans }}</label>
                        {{ form_widget(searchForm.status) }}
                        {{ form_errors(searchForm.status) }}
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.member_id'|trans }}</label>
                        {{ form_widget(searchForm.member_id) }}
                        {{ form_errors(searchForm.member_id) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.order_no'|trans }}</label>
                        {{ form_widget(searchForm.order_no) }}
                        {{ form_errors(searchForm.order_no) }}
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.customer_id'|trans }}</label>
                        {{ form_widget(searchForm.customer_id) }}
                        {{ form_errors(searchForm.customer_id) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.customer_name'|trans }}</label>
                        {{ form_widget(searchForm.customer_name) }}
                        {{ form_errors(searchForm.customer_name) }}
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.customer_kana'|trans }}</label>
                        {{ form_widget(searchForm.customer_kana) }}
                        {{ form_errors(searchForm.customer_kana) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.customer_mail'|trans }}</label>
                        {{ form_widget(searchForm.customer_mail) }}
                        {{ form_errors(searchForm.customer_mail) }}
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.customer_tel'|trans }}</label>
                        {{ form_widget(searchForm.customer_tel) }}
                        {{ form_errors(searchForm.customer_tel) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.product_name'|trans }}</label>
                        {{ form_widget(searchForm.product_name) }}
                        {{ form_errors(searchForm.product_name) }}
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.total'|trans }}</label>
                        <div class="form-row align-items-center">
                            <div class="col">
                            {{ form_widget(searchForm.total_start) }}
                            {{ form_errors(searchForm.total_start) }}
                            </div>
                            <div class="col-auto text-center">{{ 'admin.common.separator__range'|trans }}</div>
                            <div class="col">
                            {{ form_widget(searchForm.total_end) }}
                            {{ form_errors(searchForm.total_end) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.order_date'|trans }}</label>
                        <div class="form-row align-items-center">
                            <div class="col">
                            {{ form_widget(searchForm.order_date_start) }}
                            {{ form_errors(searchForm.order_date_start) }}
                            </div>
                            <div class="col-auto text-center">{{ 'admin.common.separator__range'|trans }}</div>
                            <div class="col">
                            {{ form_widget(searchForm.order_date_end) }}
                            {{ form_errors(searchForm.order_date_end) }}
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <label class="col-form-label">{{ 'remise_payment4.ac.admin_management_index.label.search.next_date'|trans }}</label>
                        <div class="form-row align-items-center">
                            <div class="col">
                            {{ form_widget(searchForm.next_date_start) }}
                            {{ form_errors(searchForm.next_date_start) }}
                            </div>
                            <div class="col-auto text-center">{{ 'admin.common.separator__range'|trans }}</div>
                            <div class="col">
                            {{ form_widget(searchForm.next_date_end) }}
                            {{ form_errors(searchForm.next_date_end) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="c-outsideBlock__contents">
                <div class="row">
                    <div class="mb-4">
                        <div class="col-12">
                            <button class="btn btn-ec-conversion px-5" type="submit" id="search_submit">{{ 'admin.common.search'|trans }}</button>
                            {% if pagination %}
                                <span class="font-weight-bold ml-2" id="search_total_count">{{ 'admin.common.search_result'|trans({"%count%":pagination.totalItemCount})|raw }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <div class="c-outsideBlock__contents mb-5">
                {{ include('@admin/search_items.twig', { 'form': searchForm }, ignore_missing = true) }}
            </div>
        </form>
    </div>
    <!--検索条件設定テーブルここまで-->

    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <form id="form_bulk" method="POST" action="">
                    <div class="row justify-content-between mb-2">
                        <div class="col-6">
                        </div>
                        <div class="col-5 text-end">
                            <div class="d-inline-block mr-2">
                                <div>
                                    <select class="custom-select" onchange="location = this.value;">
                                        {% for pageMax in pageMaxis %}
                                            <option {% if pageMax.name == page_count %}selected=""{% endif %} value="{{ path('remise_payment4_ac_management_index_page', {'page_no': 1, 'page_count': pageMax.name}) }}">{{ 'admin.common.count'|trans({ '%count%': pageMax.name }) }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="d-inline-block">
                                {% if remiseCsvType %}
                                <div class="btn-group" role="group">
                                    <a class="btn btn-ec-regular" href="{{ url('remise_payment4_ac_management_csvexport') }}">
                                        <i class="fa fa-cloud-download mr-1 text-secondary"></i><span>{{ 'admin.common.csv_download'|trans }}</span>
                                    </a>
                                    <a class="btn btn-ec-regular" href="{{ url('admin_setting_shop_csv', { id : remiseCsvType.getId }) }}">
                                        <i class="fa fa-cog mr-1 text-secondary"></i><span>{{ 'admin.setting.shop.csv_setting'|trans }}</span>
                                    </a>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="card rounded border-0 mb-4 d-block">
                        <div class="card-body p-0">
                            <table class="table table-sm">
                                <thead>
                                <tr>
                                    <th class="border-top-0 pl-3 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname1'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname2'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname3'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname4'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname5'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname6'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname7'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname8'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'remise_payment4.ac.admin_management_index.label.table.colname9'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for remiseACMember in pagination %}
                                    {% set orderResultCards = remiseACMember.getOrderResultCards %}
                                    {% set latestOrderResultCard = orderResultCards[0] %}
                                    {% set latestOrderResult = latestOrderResultCard.getOrderResult %}
                                    {% set latestOrder = latestOrderResult.getOrder %}
                                    {% set latestOrderItems = latestOrder.getOrderItems %}
                                    {% set latestOrderItem = null %}
                                    {% for tempLatestOrderItem in latestOrderItems %}
                                        {% if tempLatestOrderItem.isProduct %}
                                        {% set latestOrderItem = tempLatestOrderItem %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set latestCustomer = latestOrder.getCustomer %}
                                    {% set firstOrderResultCard = orderResultCards[orderResultCards|length -1 ] %}
                                    {% set firstOrderResult = firstOrderResultCard.getOrderResult %}
                                    {% set firstOrder = firstOrderResult.getOrder %}
                                    <tr id="ex-remise-ac-member-{{ remiseACMember.getId }}">
                                        <td class="align-middle pl-3">
                                            <a href="{{ url('remise_payment4_ac_management_edit', { 'id': remiseACMember.getId}) }}">
                                            {{ remiseACMember.getId }}
                                            </a>
                                        </td>
                                        {% if latestCustomer != null %}
                                        <td class="align-middle">
                                            <a href="{{ url('admin_customer_edit', { 'id': latestCustomer.getId}) }}">
                                            {{ latestCustomer.getId }}
                                            </a>
                                        </td>
                                        {% else %}
                                        <td class="align-middle">{{ 'remise_payment4.ac.common.text.nonmember'|trans }}</td>
                                        {% endif %}
                                        {% if latestCustomer != null %}
                                        <td class="align-middle">{{ latestCustomer.getName01 }}　{{ latestCustomer.getName02 }}</td>
                                        {% else %}
                                        <td class="align-middle">{{ latestOrder.getName01 }}　{{ latestOrder.getName02 }}</td>
                                        {% endif %}
                                        {% if latestOrderItem != null %}
                                        <td class="align-middle">
                                        {{ latestOrderItem.getProductName }}
                                        {% if latestOrderItem.getClassCategoryName1 %}
                                            {{ latestOrderItem.getClassCategoryName1 }}
                                        {% endif %}
                                        {% if latestOrderItem.getClassCategoryName2 %}
                                            / {{ latestOrderItem.getClassCategoryName2 }}
                                        {% endif %}
                                        </td>
                                        {% else %}
                                        <td class="align-middle">-</td>
                                        {% endif %}
                                        <td class="align-middle">
                                            <a class="action-edit" href="{{ url('admin_order_edit', { id : firstOrder.getId }) }}">
                                            {{ firstOrder.getOrderNo }}
                                            </a>
                                        </td>
                                        <td class="align-middle">
                                            <a class="action-edit" href="{{ url('admin_order_edit', { id : latestOrder.getId }) }}">
                                            {{ latestOrder.getOrderNo }}
                                            </a>
                                        </td>
                                        <td class="align-middle">{{ remiseACMember.getTotal }}</td>
                                        <td class="align-middle">{{ remiseACMember.getNextDate|date("Y/m/d") }}</td>
                                        {% if remiseACMember.isStatus == true %}
                                        <td class="align-middle">{{ 'remise_payment4.ac.plg_remise_payment4_remise_ac_member.status.1'|trans }}</td>
                                        {% elseif remiseACMember.isStatus == false %}
                                        <td class="align-middle">{{ 'remise_payment4.ac.plg_remise_payment4_remise_ac_member.status.0'|trans }}</td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="row justify-content-md-center mb-4">
                            {% if pagination.totalItemCount > 0 %}
                                {% include "@admin/pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'remise_payment4_ac_management_index_page' } %}
                            {% endif %}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
