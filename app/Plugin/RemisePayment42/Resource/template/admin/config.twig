                                                            <input type="hidden" id="config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__mode" name="config_tax[remise_tax_rate][{{ remiseTaxRate.getId }}][mode]" value="upd">
                                                        </td>
                                                    </tr>
                                                {% endfor %}
