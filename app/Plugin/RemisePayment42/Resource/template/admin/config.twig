                                                                    <span class="input-group-text">%</span>
                                                                </div>

                                                            </div>
                                                            <div class="clearboth text-danger small" id="config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__tax_rate_err"></div>
                                                        </td>
                                                        <td id="tax_rule_list__calc_rule--{{ remiseTaxRate.getId }}">
                                                            <select id="config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__calc_rule" name="config_tax[remise_tax_rate][{{ remiseTaxRate.getId }}][calc_rule]" class="form-control">
                                                            {% if remiseTaxRate.getCalcRule == 1 %}
                                                                <option value="1" selected>{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.1'|trans }}</option>
                                                                <option value="2">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.2'|trans }}</option>
                                                                <option value="3">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.3'|trans }}</option>
                                                            {% elseif remiseTaxRate.getCalcRule == 2 %}
                                                                <option value="1">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.1'|trans }}</option>
                                                                <option value="2" selected>{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.2'|trans }}</option>
                                                                <option value="3">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.3'|trans }}</option>
                                                            {% elseif remiseTaxRate.getCalcRule == 3 %}
                                                                <option value="1">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.1'|trans }}</option>
                                                                <option value="2">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.2'|trans }}</option>
                                                                <option value="3" selected>{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.3'|trans }}</option>
                                                            {% endif %}
