                                                            {% else %}
                                                                {{ 'remise_payment4.admin_config.label.tax_rate_status.3'|trans }}
                                                            {% endif %}
                                                        </td>
                                                        <td id="tax_rule_list__edit--{{ remiseTaxRate.getId }}">
