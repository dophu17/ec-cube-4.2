                                                        </td>
                                                        <td id="tax_rule_list__apply_date--{{ remiseTaxRate.getId }}">
                                                            <input type="datetime-local" id="config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__apply_date" name="config_tax[remise_tax_rate][{{ remiseTaxRate.getId }}][apply_date]" class="datetimepicker-input form-control" style="position: relative;" data-bs-target="#config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__apply_date" data-bs-toggle="datetimepicker" value="{{ remiseTaxRate.getApplyDate|date('Y-m-d') }}T{{ remiseTaxRate.getApplyDate|date('H:i') }}"/>
                                                            <div class="clearboth text-danger small" id="config_tax_remise_tax_rate__{{ remiseTaxRate.getId }}__apply_date_err"></div>
                                                        </td>
                                                        <td id="tax_rule_list__status--{{ remiseTaxRate.getId }}">
                                                            {% if remiseTaxRate.getId == currentTaxRate.getId %}
                                                                {{ 'remise_payment4.admin_config.label.tax_rate_status.1'|trans }}
