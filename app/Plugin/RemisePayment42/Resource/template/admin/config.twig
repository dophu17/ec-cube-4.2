{% block javascript %}
<script type="text/javascript">
{{ include('RemisePayment42/Resource/assets/js/admin/config.js') }}
{{ include('RemisePayment42/Resource/assets/js/admin/jquery.validate.js') }}
$(function(){

    if ($('[type="datetime-local"]').prop('type') != 'datetime-local') {
        // 適用日時のカレンダー設定
        $.when(
            $.getScript("{{ asset('assets/js/vendor/moment.min.js', 'admin') }}"),
            $.getScript("{{ asset('assets/js/vendor/moment-with-locales.min.js', 'admin') }}"),
            $.getScript("{{ asset('assets/js/vendor/tempusdominus-bootstrap-4.min.js', 'admin') }}")
        ).done(function() {
        {%  for remiseTaxRate in allTaxRateArray %}
            $('input[id$=__apply_date]').datetimepicker({
                locale: '{{ eccube_config.locale }}',
                format: 'YYYY/MM/DD HH:mm',
                useCurrent: false,
                buttons: {
                    showToday: true,
                    showClose: true
                }
            });
            $('#config_tax_remise_tax_rate__{{remiseTaxRate.getId}}__apply_date').val("{{ remiseTaxRate.getApplyDate|date('Y/m/d H:i') }}");
        {% endfor %}
        });
    }

    // 税率設定入力チェック追加
    remise_valitation();
});

function remise_valitation() {
    $.validator.addMethod("selectCheck", function(value, element, origin){
        return origin != value;
    });
    $('form').validate({
        rules: {
            {%  for remiseTaxRate in allTaxRateArray %}
            "config_tax[remise_tax_rate][{{remiseTaxRate.id}}][tax_rate]" :{
                required: {
                    depends: function (element) {
                        if($('#config_tax_remise_tax_rate__{{remiseTaxRate.getId}}__mode').val() != "del"){
                            return $('#config_use_payment_1').is(':checked');
                        }else{
                            return false;
                        }
                     }
                },
                min: 1,
                max: 100,
            },
            "config_tax[remise_tax_rate][{{remiseTaxRate.id}}][calc_rule]" :{
                required: {
                    depends: function (element) {
                        if($('#config_tax_remise_tax_rate__{{remiseTaxRate.getId}}__mode').val() != "del"){
                            return $('#config_use_payment_1').is(':checked');
                        }else{
                            return false;
                        }
                     }
                },
            },
            "config_tax[remise_tax_rate][{{remiseTaxRate.id}}][apply_date]" :{
                required: {
                    depends: function (element) {
                        if($('#config_tax_remise_tax_rate__{{remiseTaxRate.getId}}__mode').val() != "del"){
                            return $('#config_use_payment_1').is(':checked');
                        }else{
                            return false;
                        }
                     }
                },
            },
            {% endfor %}
        },
        messages: {
            {%  for remiseTaxRate in allTaxRateArray %}
            "config_tax[remise_tax_rate][{{remiseTaxRate.getId}}][tax_rate]" :{
                required: "※ 消費税率が入力されていません。",
                min: '※ 消費税率は1～100の数値で入力してください。',
                max: '※ 消費税率は1～100の数値で入力してください。',
            },
            "config_tax[remise_tax_rate][{{remiseTaxRate.getId}}][calc_rule]" :{
                required: "※ 課税規則が選択されていません。",
            },
            "config_tax[remise_tax_rate][{{remiseTaxRate.getId}}][apply_date]" :{
                required: "※ 適用日時が入力されていません。",
            },
            {% endfor %}
        },
        errorPlacement: function(error, element) {
            var objName = element.attr("name");
            var errId = objName.replace(/\[\]/g, "").replace(/\[/g, "_").replace(/\]/g, "_") + "err";
            $('#' + errId).empty();
            error.appendTo('#' + errId);
        }
    });
    $('form').data("validator").settings.ignore = "input[type='hidden']";
}


// 消費税率設定 新規追加
$('[id^="config_tax_remise_tax_rate_add"]').click(function () {

    $("#cvs_tax_id_count").val( Number($("#cvs_tax_id_count").val()) + 1 );
    var newTaxId = "new_" + $("#cvs_tax_id_count").val();

    var taxData = "";
    taxData = '<tr id="tax_rule_list__item--' + newTaxId + '">';
        // ID
        taxData += '<td id="tax_rule_list__id--' + newTaxId + '">-</td>';
        // 消費税率
        taxData += '<td id="tax_rule_list__tax_rate--' + newTaxId + '">';
        taxData += '<div class="input-group">';
        taxData += '<input type="number" id="config_tax_remise_tax_rate__' + newTaxId + '__tax_rate" name="config_tax[remise_tax_rate][' + newTaxId + '][tax_rate]" class="col-auto text-end form-control" value="">';
        taxData += '<div class="input-group-append">';
        taxData += '<span class="input-group-text">%</span>';
        taxData += '</div>';
        taxData += '</div>';
        taxData += '<div class="clearboth text-danger small" id="config_tax_remise_tax_rate__' + newTaxId + '__tax_rate_err"></div>';
        taxData += '</td>';
        // 課税規則
        taxData += '<td id="tax_rule_list__calc_rule--' + newTaxId + '">';
        taxData += '<select id="config_tax_remise_tax_rate__' + newTaxId + '__calc_rule" name="config_tax[remise_tax_rate][' + newTaxId + '][calc_rule]" class="form-control">';
        taxData += '<option value="1" selected>{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.1'|trans }}</option>';
        taxData += '<option value="2">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.2'|trans }}</option>';
        taxData += '<option value="3">{{ 'remise_payment4.admin_config.label.tax_rate_calc_rule.3'|trans }}</option>';
        taxData += '</select>';
        taxData += '<div class="clearboth text-danger small" id="config_tax_remise_tax_rate__' + newTaxId + '__calc_rule_err"></div>';
        taxData += '</td>';
        // 適用日時
        taxData += '<td id="tax_rule_list__apply_date--' + newTaxId + '">';
        taxData += '<input type="datetime-local" id="config_tax_remise_tax_rate__' + newTaxId + '__apply_date" name="config_tax[remise_tax_rate][' + newTaxId + '][apply_date]" class="datetimepicker-input form-control" style="position: relative;" data-bs-target="#config_tax_remise_tax_rate__' + newTaxId + '__apply_date" data-bs-toggle="datetimepicker" value=""/>';
        taxData += '<div class="clearboth text-danger small" id="config_tax_remise_tax_rate__' + newTaxId + '__apply_date_err"></div>';
        taxData += '</td>';
        // 適用状態
        taxData += '<td id="tax_rule_list__status--' + newTaxId + '"><span style="color:red">{{ 'remise_payment4.admin_config.label.tax_rate_status.4'|trans }}</span></td>';
        // 変更
        taxData += '<td id="tax_rule_list__edit--' + newTaxId + '">';
        taxData += '<input type="button" id="config_tax_remise_tax_rate__' + newTaxId + '__del" class="btn btn-ec-regular" value="{{ 'remise_payment4.admin_config.label.tax_rate_button.del'|trans }}" onClick="remiseTaxRateDel(' + "'" + newTaxId + "'" + ')">';
        taxData += '<input type="hidden" id="config_tax_remise_tax_rate__' + newTaxId + '__mode" name="config_tax[remise_tax_rate][' + newTaxId + '][mode]" value="new">';
        taxData += '</td>';
    taxData += "</tr>";
    $('#tax_rule_list_tbody').append(taxData);

    // 入力チェック追加　消費税率
    $('#config_tax_remise_tax_rate__' + newTaxId + '__tax_rate').rules('add', {
        required: {
            depends: function (element) {
                if($('#config_tax_remise_tax_rate__' + newTaxId + '__mode').val() != "del"){
                    return $('#config_use_payment_1').is(':checked');
                }else{
                    return false;
                }
             }
        },
        min: 1,
        max: 100,
        messages: {
            required: '※ 消費税率が入力されていません。',
            min: '※ 消費税率は1～100の数値で入力してください。',
            max: '※ 消費税率は1～100の数値で入力してください。',
        }
    });

    // 入力チェック追加　課税規則
    $('#config_tax_remise_tax_rate__' + newTaxId + '__calc_rule').rules('add', {
        required: {
            depends: function (element) {
                if($('#config_tax_remise_tax_rate__' + newTaxId + '__mode').val() != "del"){
                    return $('#config_use_payment_1').is(':checked');
                }else{
                    return false;
                }
             }
        },
        messages: {
          required: '※ 課税規則が選択されていません。',
        }
    });

    // 入力チェック追加　適用日時
    $('#config_tax_remise_tax_rate__' + newTaxId + '__apply_date').rules('add', {
        required: {
            depends: function (element) {
                if($('#config_tax_remise_tax_rate__' + newTaxId + '__mode').val() != "del"){
                    return $('#config_use_payment_1').is(':checked');
                }else{
                    return false;
                }
             }
        },
        messages: {
          required: '※ 適用日時が入力されていません。'
        }
    });

    // カレンダー表示追加　適用日時
    $('#config_tax_remise_tax_rate__' + newTaxId + '__apply_date').datetimepicker({
        locale: 'ja',
        format: 'YYYY-MM-DD HH:mm',
        useCurrent: false,
        showTodayButton: true
    });

});

// 消費税率削除
function remiseTaxRateDel(id)
{
    if($("#config_tax_remise_tax_rate__" + id + "__mode").val() != "del")
    {
        $("#config_tax_remise_tax_rate__" + id + "__tax_rate").prop("disabled", true);
        $("#config_tax_remise_tax_rate__" + id + "__calc_rule").prop("disabled", true);
        $("#config_tax_remise_tax_rate__" + id + "__apply_date").prop("disabled", true);
        $("#config_tax_remise_tax_rate__" + id + "__del").val("削除解除");
        $("#config_tax_remise_tax_rate__" + id + "__mode").val("del");
    }else{
        $("#config_tax_remise_tax_rate__" + id + "__tax_rate").prop("disabled", false);
        $("#config_tax_remise_tax_rate__" + id + "__calc_rule").prop("disabled", false);
        $("#config_tax_remise_tax_rate__" + id + "__apply_date").prop("disabled", false);
        $("#config_tax_remise_tax_rate__" + id + "__del").val("削除");
        if(id.indexOf("new") !== -1){
            $("#config_tax_remise_tax_rate__" + id + "__mode").val("new");
        }else{
            $("#config_tax_remise_tax_rate__" + id + "__mode").val("upd");
        }
    }
}

</script>
